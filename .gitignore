# ==============================================================================
# PixelFed Analytics Engineering - .gitignore
# ==============================================================================

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Local build artifacts
build/
dist/
*.egg-info/
.eggs/

# IDE and OS metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary and test landing directories
tmp/
tmp_*/
data/landing/
data/landing_*/

# Data files (large, machine-specific outputs)
*.sqlite
*.sqlite3
*.db
*.csv
*.csv.gz
*.jsonl
*.xlsx
*.parquet
*.feather

# Power BI local/temporary files (preserve .pbip project definitions)
*.pbix
*.pbit
*.tmp
~$*.xlsx# Local generated PixelFed SQLite snapshot
/data/landing/relational_sqlite/pixelfed_source_snapshot.sqlite
/data/landing/relational_sqlite/pixelfed_source_snapshot.sqlite-wal
/data/landing/relational_sqlite/pixelfed_source_snapshot.sqlite-shm
