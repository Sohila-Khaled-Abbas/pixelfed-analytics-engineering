expression stg_account_logs = ```
		let
		    FilePath =
		        pLakehousePath & "\streaming_jsonl\account_logs.jsonl",
		
		    Lines = 
		    Lines.FromBinary(
		        File.Contents(FilePath),
		        null,
		        null,
		        TextEncoding.Utf8
		    ),
		
		    NonEmptyLines =
		        List.Select(
		            Lines,
		            each Text.Trim(_) <> ""
		        ),
		
		    ParsedRecords =
		        List.Transform(
		            NonEmptyLines,
		            each Json.Document(Text.ToBinary(_))
		        ),
		
		    Output =
		        Table.FromRecords(ParsedRecords),
		  #"Changed column type" = Table.TransformColumnTypes(Output, {{"id", Int64.Type}, {"user_id", Int64.Type}, {"item_id", Int64.Type}, {"item_type", type text}, {"action", type text}, {"message", type text}, {"ip_address", type text}, {"user_agent", type text}, {"metadata", type text}, {"created_at", type datetime}, {"updated_at", type datetime}})
		in
		    #"Changed column type"
		```
	lineageTag: 9bbe4c1f-b4fb-47c1-899c-175e3351ce6f
	queryGroup: 01_Staging

