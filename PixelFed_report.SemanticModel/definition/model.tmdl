model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 01_Staging

	annotation PBI_QueryGroupOrder = 1

queryGroup 00_Data_Sources

	annotation PBI_QueryGroupOrder = 0

queryGroup 02_Dimensions

	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Facts

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["pLakehousePath","ODBC (dsn=MySQLiteDB)","stg_users","stg_profiles","stg_statuses","stg_likes","stg_comments","stg_media","stg_followers","stg_hashtags","stg_account_logs","stg_activities","stg_notifications","stg_direct_messages"]

ref cultureInfo en-US

