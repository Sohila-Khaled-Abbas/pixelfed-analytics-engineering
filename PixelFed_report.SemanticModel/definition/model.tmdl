model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 01_Staging

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["pLakehousePath","stg_users","stg_profiles","stg_statuses","stg_likes","stg_comments","stg_media","stg_followers","stg_hashtags","stg_account_logs","stg_activities","stg_notifications","stg_direct_messages"]

ref cultureInfo en-US

