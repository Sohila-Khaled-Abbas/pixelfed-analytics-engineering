  /// Staging table sourced from the exact schema table `websockets_statistics_entries`.
  table stg_websockets_statistics_entries
    column 'id'
      dataType: int64
      isKey
      sourceColumn: "id"
      summarizeBy: none
    column 'app_id'
      dataType: string
      sourceColumn: "app_id"
      summarizeBy: none
    column 'peak_connection_count'
      dataType: int64
      sourceColumn: "peak_connection_count"
      summarizeBy: none
    column 'websocket_message_count'
      dataType: int64
      sourceColumn: "websocket_message_count"
      summarizeBy: none
    column 'api_message_count'
      dataType: int64
      sourceColumn: "api_message_count"
      summarizeBy: none
    column 'created_at'
      dataType: dateTime
      sourceColumn: "created_at"
      summarizeBy: none
    column 'updated_at'
      dataType: dateTime
      sourceColumn: "updated_at"
      summarizeBy: none

    partition stg_websockets_statistics_entries = m
      mode: import
      source = ```
          let
              Source = Lines.FromBinary(Binary.Buffer(File.Contents(pLakehousePath & "\jsonl\websockets_statistics_entries.jsonl")), null, 65001),
              NonEmptyLines = List.Select(Source, each Text.Trim(_) <> ""),
              ParsedRecords = List.Transform(NonEmptyLines, each Json.Document(Text.ToBinary(_))),
              Records = Table.FromRecords(ParsedRecords),
              
              Typed = Table.TransformColumnTypes(Records, {{"id", Int64.Type}, {"app_id", type text}, {"peak_connection_count", Int64.Type}, {"websocket_message_count", Int64.Type}, {"api_message_count", Int64.Type}, {"created_at", DateTime.Type}, {"updated_at", DateTime.Type}}, "en-US")
          in
              Typed
          ```
