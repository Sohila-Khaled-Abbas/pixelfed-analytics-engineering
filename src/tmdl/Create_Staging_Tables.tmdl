  /// Staging table sourced from the exact schema table `report_logs`.
  table stg_report_logs
    column 'id'
      dataType: int64
      isKey
      sourceColumn: "id"
      summarizeBy: none
    column 'profile_id'
      dataType: int64
      sourceColumn: "profile_id"
      summarizeBy: none
    column 'item_id'
      dataType: int64
      sourceColumn: "item_id"
      summarizeBy: none
    column 'item_type'
      dataType: string
      sourceColumn: "item_type"
      summarizeBy: none
    column 'action'
      dataType: string
      sourceColumn: "action"
      summarizeBy: none
    column 'system_message'
      dataType: int64
      sourceColumn: "system_message"
      summarizeBy: none
    column 'metadata'
      dataType: string
      sourceColumn: "metadata"
      summarizeBy: none
    column 'created_at'
      dataType: dateTime
      sourceColumn: "created_at"
      summarizeBy: none
    column 'updated_at'
      dataType: dateTime
      sourceColumn: "updated_at"
      summarizeBy: none

    partition stg_report_logs = m
      mode: import
      source = ```
          let
              Source = Lines.FromBinary(Binary.Buffer(File.Contents(pLakehousePath & "\jsonl\report_logs.jsonl")), null, 65001),
              NonEmptyLines = List.Select(Source, each Text.Trim(_) <> ""),
              ParsedRecords = List.Transform(NonEmptyLines, each Json.Document(Text.ToBinary(_))),
              Records = Table.FromRecords(ParsedRecords),
              JsonAsText = List.Accumulate(
                  {"metadata"},
                  Records,
                  (state, colName) => if Table.HasColumns(state, {colName})
                      then Table.TransformColumns(state, {{colName, each if _ = null then null else Text.FromBinary(Json.FromValue(_)), type text}})
                      else state
              ),
              Typed = Table.TransformColumnTypes(JsonAsText, {{"id", Int64.Type}, {"profile_id", Int64.Type}, {"item_id", Int64.Type}, {"item_type", type text}, {"action", type text}, {"system_message", Int64.Type}, {"metadata", type text}, {"created_at", DateTime.Type}, {"updated_at", DateTime.Type}}, "en-US")
          in
              Typed
          ```

