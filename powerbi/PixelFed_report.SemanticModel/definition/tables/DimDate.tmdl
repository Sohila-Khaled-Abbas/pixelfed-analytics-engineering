	partition DimDate = m
		mode: import
		queryGroup: 03_Dimensions
		source =
				let
				    // ---------------------------------------------------------
				    // 1. Extract valid dates from a staging table column.
				    // Nulls, invalid values and missing columns are handled.
				    // ---------------------------------------------------------
				    GetDateValues = (source as table, columnName as text) as list =>
				        if Table.HasColumns(source, {columnName}) then
				            List.RemoveNulls(
				                List.Transform(
				                    Table.Column(source, columnName),
				                    each try Date.From(_) otherwise null
				                )
				            )
				        else
				            {},
				
				    // ---------------------------------------------------------
				    // 2. Collect event dates from the PixelFed staging queries.
				    // Extend this list when adding another event fact source.
				    // ---------------------------------------------------------
				    EventDates = List.Combine({
				        GetDateValues(stg_statuses, "created_at"),
				        GetDateValues(stg_likes, "created_at"),
				        GetDateValues(stg_comments, "created_at"),
				        GetDateValues(stg_followers, "created_at"),
				        GetDateValues(stg_media, "created_at"),
				        GetDateValues(stg_story_views, "created_at")
				    }),
				
				    ValidDates = List.Buffer(EventDates),
				
				    // ---------------------------------------------------------
				    // 3. Discover the boundaries dynamically on every refresh.
				    // Fail clearly if all selected source dates are blank.
				    // ---------------------------------------------------------
				    StartDate =
				        if List.IsEmpty(ValidDates) then
				            error "DimDate: no valid event dates found in the selected staging queries."
				        else
				            List.Min(ValidDates),
				
				    EndDate = List.Max(ValidDates),
				
				    // ---------------------------------------------------------
				    // 4. Generate a continuous calendar date spine.
				    // Both the earliest and latest dates are included.
				    // ---------------------------------------------------------
				    DateList = List.Dates(
				        StartDate,
				        Duration.Days(EndDate - StartDate) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				
				    DateTable = Table.FromList(
				        DateList,
				        Splitter.SplitByNothing(),
				        {"Date"},
				        null,
				        ExtraValues.Error
				    ),
				
				    TypedDate = Table.TransformColumnTypes(
				        DateTable,
				        {{"Date", type date}}
				    ),
				
				    // ---------------------------------------------------------
				    // 5. Calendar key and standard date attributes.
				    // DateKey format: YYYYMMDD.
				    // ---------------------------------------------------------
				    AddDateKey = Table.AddColumn(
				        TypedDate,
				        "DateKey",
				        each Int64.From(
				            Date.Year([Date]) * 10000
				            + Date.Month([Date]) * 100
				            + Date.Day([Date])
				        ),
				        Int64.Type
				    ),
				
				    AddYear = Table.AddColumn(
				        AddDateKey,
				        "Year",
				        each Date.Year([Date]),
				        Int64.Type
				    ),
				
				    AddQuarterNumber = Table.AddColumn(
				        AddYear,
				        "QuarterNumber",
				        each Date.QuarterOfYear([Date]),
				        Int64.Type
				    ),
				
				    AddQuarterName = Table.AddColumn(
				        AddQuarterNumber,
				        "QuarterName",
				        each "Q" & Text.From([QuarterNumber])
				            & " " & Text.From([Year]),
				        type text
				    ),
				
				    AddMonthNumber = Table.AddColumn(
				        AddQuarterName,
				        "MonthNumber",
				        each Date.Month([Date]),
				        Int64.Type
				    ),
				
				    AddMonthName = Table.AddColumn(
				        AddMonthNumber,
				        "MonthName",
				        each Date.ToText([Date], "MMMM", "en-US"),
				        type text
				    ),
				
				    AddYearMonth = Table.AddColumn(
				        AddMonthName,
				        "YearMonth",
				        each Date.ToText([Date], "yyyy-MM", "en-US"),
				        type text
				    ),
				
				    AddMonthYear = Table.AddColumn(
				        AddYearMonth,
				        "MonthYear",
				        each Date.ToText([Date], "MMM yyyy", "en-US"),
				        type text
				    ),
				
				    // Numeric sort key for MonthYear / YearMonth labels.
				    AddYearMonthSort = Table.AddColumn(
				        AddMonthYear,
				        "YearMonthSort",
				        each [Year] * 100 + [MonthNumber],
				        Int64.Type
				    ),
				
				    AddWeekOfYear = Table.AddColumn(
				        AddYearMonthSort,
				        "WeekOfYear",
				        each Date.WeekOfYear([Date], Day.Monday),
				        Int64.Type
				    ),
				
				    AddDayOfMonth = Table.AddColumn(
				        AddWeekOfYear,
				        "DayOfMonth",
				        each Date.Day([Date]),
				        Int64.Type
				    ),
				
				    // Monday = 1, Sunday = 7.
				    AddDayOfWeekNumber = Table.AddColumn(
				        AddDayOfMonth,
				        "DayOfWeekNumber",
				        each Date.DayOfWeek([Date], Day.Monday) + 1,
				        Int64.Type
				    ),
				
				    AddDayName = Table.AddColumn(
				        AddDayOfWeekNumber,
				        "DayName",
				        each Date.ToText([Date], "dddd", "en-US"),
				        type text
				    ),
				
				    AddIsWeekend = Table.AddColumn(
				        AddDayName,
				        "IsWeekend",
				        each Date.DayOfWeek([Date], Day.Monday) >= 5,
				        type logical
				    ),
				
				    AddIsMonthStart = Table.AddColumn(
				        AddIsWeekend,
				        "IsMonthStart",
				        each [Date] = Date.StartOfMonth([Date]),
				        type logical
				    ),
				
				    AddIsMonthEnd = Table.AddColumn(
				        AddIsMonthStart,
				        "IsMonthEnd",
				        each [Date] = Date.EndOfMonth([Date]),
				        type logical
				    ),
				
				    // Keep the fields in a reporting-friendly order.
				    Final = Table.ReorderColumns(
				        AddIsMonthEnd,
				        {
				            "Date", "DateKey", "Year",
				            "QuarterNumber", "QuarterName",
				            "MonthNumber", "MonthName",
				            "YearMonth", "MonthYear", "YearMonthSort",
				            "WeekOfYear", "DayOfMonth",
				            "DayOfWeekNumber", "DayName",
				            "IsWeekend", "IsMonthStart", "IsMonthEnd"
				        }
				    )
				in
				    Final

