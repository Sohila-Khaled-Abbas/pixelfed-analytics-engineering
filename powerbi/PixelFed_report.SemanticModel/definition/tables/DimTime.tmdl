		sourceColumn: DayPart

		annotation SummarizationSetBy = Automatic

	partition DimTime = m
		mode: import
		queryGroup: 03_Dimensions
		source =
				let
				    // ---------------------------------------------------------
				    // 1. Generate all 1,440 minutes in a 24-hour day.
				    // MinuteOfDay ranges from 0 to 1,439.
				    // ---------------------------------------------------------
				    MinuteNumbers = List.Numbers(0, 24 * 60, 1),
				
				    BaseTable = Table.FromList(
				        MinuteNumbers,
				        Splitter.SplitByNothing(),
				        {"MinuteOfDay"},
				        null,
				        ExtraValues.Error
				    ),
				
				    TypedBase = Table.TransformColumnTypes(
				        BaseTable,
				        {{"MinuteOfDay", Int64.Type}}
				    ),
				
				    // ---------------------------------------------------------
				    // 2. Convert each minute offset into a genuine Time value.
				    // ---------------------------------------------------------
				    AddTime = Table.AddColumn(
				        TypedBase,
				        "Time",
				        each Time.From(
				            #datetime(2000, 1, 1, 0, 0, 0)
				            + #duration(0, 0, [MinuteOfDay], 0)
				        ),
				        type time
				    ),
				
				    // Key format HHMM. Example: 09:05 becomes 905.
				    AddTimeKey = Table.AddColumn(
				        AddTime,
				        "TimeKey",
				        each Time.Hour([Time]) * 100
				            + Time.Minute([Time]),
				        Int64.Type
				    ),
				
				    AddHour24 = Table.AddColumn(
				        AddTimeKey,
				        "Hour24",
				        each Time.Hour([Time]),
				        Int64.Type
				    ),
				
				    AddHour12 = Table.AddColumn(
				        AddHour24,
				        "Hour12",
				        each
				            if Number.Mod([Hour24], 12) = 0 then
				                12
				            else
				                Number.Mod([Hour24], 12),
				        Int64.Type
				    ),
				
				    AddMinuteNumber = Table.AddColumn(
				        AddHour12,
				        "MinuteNumber",
				        each Time.Minute([Time]),
				        Int64.Type
				    ),
				
				    AddAMPM = Table.AddColumn(
				        AddMinuteNumber,
				        "AMPM",
				        each if [Hour24] < 12 then "AM" else "PM",
				        type text
				    ),
				
				    AddHourLabel = Table.AddColumn(
				        AddAMPM,
				        "HourLabel",
				        each Text.PadStart(
				            Text.From([Hour24]),
				            2,
				            "0"
				        ) & ":00",
				        type text
				    ),
				
				    AddTime24Label = Table.AddColumn(
				        AddHourLabel,
				        "Time24Label",
				        each Time.ToText([Time], "HH:mm", "en-US"),
				        type text
				    ),
				
				    AddTime12Label = Table.AddColumn(
				        AddTime24Label,
				        "Time12Label",
				        each Time.ToText([Time], "hh:mm tt", "en-US"),
				        type text
				    ),
				
				    // ---------------------------------------------------------
				    // 3. Business-friendly time-of-day segments.
				    // Adjust these windows if your project needs different ones.
				    // ---------------------------------------------------------
				    AddDayPart = Table.AddColumn(
				        AddTime12Label,
				        "DayPart",
				        each
				            if [Hour24] >= 5 and [Hour24] < 12 then
				                "Morning"
				            else if [Hour24] >= 12 and [Hour24] < 17 then
				                "Afternoon"
				            else if [Hour24] >= 17 and [Hour24] < 21 then
				                "Evening"
				            else
				                "Night",
				        type text
				    ),
				
				    Final = Table.ReorderColumns(
				        AddDayPart,
				        {
				            "TimeKey", "Time", "MinuteOfDay",
				            "Hour24", "Hour12", "MinuteNumber",
				            "AMPM", "HourLabel",
				            "Time24Label", "Time12Label", "DayPart"
				        }
				    )
				in
				    Final

