model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 01_Staging

	annotation PBI_QueryGroupOrder = 1

queryGroup 00_Data_Sources

	annotation PBI_QueryGroupOrder = 0

queryGroup 02_Dimensions

	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Facts_&_Bridges

	annotation PBI_QueryGroupOrder = 3

queryGroup 99_QA

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["pLakehousePath","ODBC (dsn=MySQLiteDB)","stg_account_logs","stg_activities","stg_avatars","stg_bookmarks","stg_circle_profiles","stg_circles","stg_collection_items","stg_collections","stg_comments","stg_contacts","stg_direct_messages","stg_discover_categories","stg_discover_category_hashtags","stg_email_verifications","stg_failed_jobs","stg_follow_requests","stg_followers","stg_hashtag_follows","stg_hashtags","stg_import_datas","stg_import_jobs","stg_instances","stg_jobs","stg_likes","stg_media","stg_mentions","stg_migrations","stg_mod_logs","stg_newsroom","stg_notifications","stg_oauth_access_tokens","stg_oauth_auth_codes","stg_oauth_clients","stg_oauth_personal_access_clients","stg_oauth_refresh_tokens","stg_pages","stg_password_resets","stg_places","stg_profile_sponsors","stg_profiles","stg_report_comments","stg_report_logs","stg_reports","stg_sessions","stg_status_hashtags","stg_statuses","stg_stories","stg_story_views","stg_user_devices","stg_user_filters","stg_user_invites","stg_user_settings","stg_users","stg_websockets_statistics_entries","DimUser","DimProfile"]

ref table DimUser
ref table DimProfile

ref cultureInfo en-US

